{
  "host": "127.0.0.1",
  "port": 8080,
  "sqlite_path": "alerts.db",
  "targets": [
    {
      "id": "demo",
      "url": "http://127.0.0.1:9100/metrics",
      "interval_seconds": 2,
      "timeout_seconds": 1.5,
      "max_response_bytes": 65536
    }
  ],
  "rules": [
    {
      "id": "demo-temp-high",
      "target_id": "demo",
      "metric": "demo_temperature_celsius",
      "labels": {"room": "server"},
      "threshold": 30.0,
      "duration_seconds": 5
    }
  ]
}
